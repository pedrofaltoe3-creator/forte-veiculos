# Copie para .env.local (local) ou cadastre na Vercel (produção). Nunca versione valores reais.
# Todas as chaves são lidas só no servidor: nenhuma usa o prefixo NEXT_PUBLIC_ e nada vai para o navegador.

# Supabase: Project Settings > API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Secreta. Dá acesso total ao banco. Usada só em código de servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Empresa padrão quando o domínio acessado não está em company_domains.
DEFAULT_COMPANY_SLUG=forte-veiculos

# Endereço público do site, sem barra no final. Usado em SEO e nos links de e-mail.
SITE_URL=http://localhost:3000

# Em site de demonstração, use 1 para ficar fora dos buscadores. Remova ao ir para o domínio oficial.
SITE_NOINDEX=

# Segredo para anonimizar IPs antes de gravar. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Somente para scripts de manutenção (npm run db:migrate, backup). Não cadastre na Vercel.
# Project Settings > Database > Connection string (URI)
DATABASE_URL=

# Opcional. Consulta de veículo pela placa (apiplacas.com.br). Sem o token, o campo de placa fica desligado.
PLACA_API_TOKEN=

# Opcional. E-mail de acesso e de nova senha. O Resend vem primeiro; sem ele, usa o SMTP abaixo.
# Sem nenhum dos dois, o painel mostra o link para enviar à mão.
RESEND_API_KEY=
EMAIL_FROM=nao-responda@forteveiculoscachoeiro.com.br

# Opcional. SMTP enquanto o Resend não está ligado. Com Gmail: a conta e uma senha de app do Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
